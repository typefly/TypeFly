# Copy this file to .env (cp .env.example .env) and fill in your key.
# TypeFly auto-loads .env at startup; values here never override real shell exports.

# Required: your OpenAI API key (used by the LLM planner).
OPENAI_API_KEY=sk-...

# Optional: only needed if the vision service runs on a different machine.
# EDGE_SERVICE_IP=localhost
# EDGE_SERVICE_PORT=50049
